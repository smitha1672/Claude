BENCHCTL_BIN=benchctl
BENCHCTL_CONFIG=
# Directory benchctl is run from, so its relative config/ defaults
# (psu_profiles.toml, js220_profiles.toml, js220_config.json) resolve
# consistently regardless of where this MCP server was launched from.
# Typically the benchctl repo root.
BENCHCTL_CWD=
# STT chunk length in seconds, and how many chunks to wait for a yes/no reply
# before cancelling a pending state-changing command.
JARVIS_STT_CHUNK_SECONDS=4
JARVIS_STT_MODEL=base.en
JARVIS_CONFIRM_TIMEOUT_CHUNKS=3
